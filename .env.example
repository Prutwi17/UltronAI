# UltronAI Local Development Environment Variables Template

# Application Environment
ENVIRONMENT=development
SERVER_PORT=8080
ALLOWED_ORIGINS=http://localhost:5173

# MySQL Infrastructure Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ultronai?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=ultron_user
SPRING_DATASOURCE_PASSWORD=ultron_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=ultron_mq
RABBITMQ_DEFAULT_PASS=ultron_mq_password

# Python FastAPI NLP Service Configuration
FASTAPI_NLP_URL=http://localhost:8000

# JWT Security Configuration
JWT_SECRET=c2VjcmV0LWtleS1mb3ItdWx0cm9uYWktand0LWVudGVycHJpc2Utc2VjdXJpdHktc3BlY2lmaWNhdGlvbg==
JWT_EXPIRATION_MS=900000
